# ── 비밀키 · 환경변수 (절대 커밋 금지) ──────────────────────────────
.env
.env.*
!.env.example
backend/.env
frontend/.env
frontend/.env.local
# 배포용 백엔드 주소만 담긴 파일 (비밀값 아님 — Vercel 빌드가 이 값을 읽는다)
!frontend/.env.production

# ── 파이썬 ──────────────────────────────────────────────────────
.venv/
backend/.venv/
__pycache__/
*.py[cod]
*.egg-info/

# ── 노드 · 빌드 산출물 ───────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
*.tsbuildinfo

# ── 에디터 · OS ─────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

# ── 배포 도구 ───────────────────────────────────────────────────
.vercel/

# Hugging Face Space 배포용 임시 사본 (별도 LFS 저장소)
.hf-deploy/

# 레버 로직 수동 백업본 (디스크에만 두고 저장소에는 올리지 않는다)
*.bak_*
